# Firebase (Vite)
# Copy this file to .env and paste your Firebase Web App config values from
# Firebase Console -> Project Settings -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to route Zoe's AI calls (askZoe function) to the local
# Firebase Functions emulator instead of your deployed function — useful
# while developing so you don't redeploy for every change.
# Run `firebase emulators:start --only functions` in another terminal first.
VITE_USE_FIREBASE_EMULATOR=

# Needed for push notifications (goal check-in reminders). Generate in
# Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration
# -> "Generate key pair". This is a public key, safe to expose client-side.
VITE_FIREBASE_VAPID_KEY=

# Needed to actually know if anyone uses the app. Firebase Console ->
# Analytics (enable it if you haven't) -> Project Settings -> Your apps ->
# find "Measurement ID" (starts with G-). Omit this and the app still
# works fine — you just won't get usage data.
VITE_FIREBASE_MEASUREMENT_ID=
